  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>Tiny Steps</b>\r\nPreschool Sensory Regulation\r\n\r\n<b>Goal:</b>\r\nKeep
    the children calm until the school day ends!\r\nWatch each child's color: <b>Green</b>
    = Calm | <b>Red</b> = Overloaded.\r\nIf both children overload at once, the day
    ends early!\r\n\r\n<b>Controls & Tips:</b>\r\n\u2022 <b>WASD / Arrow Keys:</b>
    Move Teacher\r\n\u2022 <b>E or Space:</b> Pick up & deliver sensory aids\r\n\u2022
    <b>Omer</b> needs <b>Headphones</b> | <b>Noa</b> needs <b>Weighted Blanket</b>\r\n\u2022
    Keep children from bumping into each other\u2014collisions raise stress!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
